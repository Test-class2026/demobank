[Unit]
Description=DemoBank web application
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/demobank/current
EnvironmentFile=/etc/demobank/demobank.env
ExecStart=/opt/demobank/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 --access-logfile - "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
